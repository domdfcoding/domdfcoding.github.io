---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}
      {%- if page.github_url -%}
        &nbsp;<a href="{{ page.github_url }}"><i class="fa-brands fa-github"></i></a>
      {%- endif -%}
      {%- if page.itch_url -%}
        &nbsp;<a href="{{ page.itch_url }}"><i class="fa-brands fa-itch-io"></i></a>
      {%- endif -%}
    </h1>
    <p class="post-description">{{ page.description }}</p>
  </header>

  <article>
    {{ content }}
  </article>


</div>
