<div class="card" style="width: 18rem;">
	<img src="{{ map.image_url }}" class="card-img-top" alt="Screenshot of the map">
	<div class="card-body">
		<h5 class="card-title">{{ map.name }}</h5>
		<p class="card-text">{{ map.desc }}</p>
		<a href="{{ map.url }}" class="btn btn-primary">View The Map</a>
	</div>
</div>
